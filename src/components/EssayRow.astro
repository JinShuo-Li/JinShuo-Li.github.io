---
import {
  articlePath,
  titleOf,
  dateOf,
  formatMonthYear,
  readingTimeOf,
  type BlogEntry,
} from "../lib/blog";

interface Props {
  entry: BlogEntry;
}

const { entry } = Astro.props;
const date = formatMonthYear(dateOf(entry));
const readTime = readingTimeOf(entry);
---

<a class="essay-row" href={articlePath(entry)}>
  <h3 class="essay-row__title">{titleOf(entry)}</h3>
  <div class="essay-row__meta">
    {date && <span>{date}</span>}
    <span>{readTime} min read</span>
  </div>
</a>
