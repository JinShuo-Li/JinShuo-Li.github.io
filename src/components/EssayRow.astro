---
import {
  articlePath,
  displayTitleOf,
  dateOf,
  formatMonthYear,
  readingTimeOf,
  type BlogEntry,
} from "../lib/blog";

interface Props {
  entry: BlogEntry;
  index?: number;
}

const { entry, index } = Astro.props;
const date = formatMonthYear(dateOf(entry));
const readTime = readingTimeOf(entry);
---

<a
  class:list={["essay-row", index !== undefined && "essay-row--indexed"]}
  href={articlePath(entry)}
>
  {index !== undefined && <span class="essay-row__index">{String(index).padStart(2, "0")}</span>}
  <div class="essay-row__body">
    <h3 class="essay-row__title">{displayTitleOf(entry)}</h3>
    <div class="essay-row__meta">
      {date && <span>{date}</span>}
      <span>{readTime} min read</span>
    </div>
  </div>
</a>
