---
import type { Project } from "../lib/site";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<a class="archive-row" href={project.url} target="_blank" rel="noopener">
  <span class="archive-row__name">{project.name}</span>
  <span class="archive-row__meta">{project.tags.join(" · ")}</span>
  <span class="archive-row__link">GitHub ↗</span>
</a>
