---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCategories, categoryPath } from "../../lib/blog";

const categories = await getCategories();
---

<BaseLayout
  title="Blog"
  description="Notes on mathematics, machine learning, computer vision, and systems by Li Jinshuo."
>
  <div class="page-head">
    <div class="container">
      <div class="kicker">Blog</div>
      <h1 class="page-head__title">Notes and writing</h1>
    </div>
  </div>

  <section class="section" aria-labelledby="categories-title">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="kicker">Categories</div>
          <h2 class="section-title" id="categories-title">Browse by category</h2>
        </div>
      </div>

      {
        categories.length > 0 ? (
          <div class="grid grid--3">
            {categories.map((category) => (
              <a class="category-card reveal" href={categoryPath(category.slug)}>
                <h3 class="category-card__name">{category.name}</h3>
                <div class="category-card__count">
                  {category.articles.length} {category.articles.length === 1 ? "article" : "articles"}
                </div>
                <div class="category-card__more">Read category →</div>
              </a>
            ))}
          </div>
        ) : (
          <p class="empty-state">No categories yet.</p>
        )
      }
    </div>
  </section>
</BaseLayout>
