---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectFeature from "../components/ProjectFeature.astro";
import ProjectArchiveRow from "../components/ProjectArchiveRow.astro";
import { featuredProjects, moreProjects } from "../lib/site";
---

<BaseLayout
  title="Projects"
  description="Selected work across mathematics, machine learning, and systems."
>
  <div class="page-head">
    <div class="container container--editorial">
      <h1 class="page-head__title">Projects</h1>
      <p class="page-head__lead">Selected work across mathematics, machine learning, and systems.</p>
    </div>
  </div>

  <section class="section section--tight">
    <div class="container container--editorial">
      <div class="feature-list">
        {
          featuredProjects.map((project, index) => (
            <ProjectFeature project={project} index={index + 1} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container container--editorial">
      <div class="index-label">Other projects</div>
      <div class="archive-list">
        {moreProjects.map((project) => <ProjectArchiveRow project={project} />)}
      </div>
    </div>
  </section>
</BaseLayout>
