---
import BaseLayout from "./BaseLayout.astro";
import {
  titleOf,
  displayTitleOf,
  descriptionOf,
  dateOf,
  formatDate,
  readingTimeOf,
  articlePath,
  sectionPath,
  splitSectionName,
  type BlogEntry,
  type BlogNode,
} from "../lib/blog";

interface Props {
  entry: BlogEntry;
  node: BlogNode;
}

const { entry, node } = Astro.props;
const title = titleOf(entry);
const description = descriptionOf(entry) || undefined;
const date = formatDate(dateOf(entry));
const readTime = readingTimeOf(entry);
const tags = entry.data.tags ?? [];
const crumbs = [...node.ancestors, ...(node.slug ? [{ name: node.name, slug: node.slug }] : [])];

const index = node.articles.findIndex((item) => item.id === entry.id);
const prev = index > 0 ? node.articles[index - 1] : undefined;
const next = index >= 0 && index < node.articles.length - 1 ? node.articles[index + 1] : undefined;
---

<BaseLayout title={title} description={description} type="article">
  <article class="article">
    <div class="container">
      <header class="article__header">
        <nav class="article__breadcrumb" aria-label="Breadcrumb">
          <a href="/blog/">Blog</a>
          {
            crumbs.map((crumb) => (
              <>
                <span aria-hidden="true"> / </span>
                <a href={sectionPath(crumb.slug)}>{splitSectionName(crumb.name).code}</a>
              </>
            ))
          }
        </nav>
        <h1 class="article__title">{title}</h1>
        <div class="article__meta">
          {date && <span>{date}</span>}
          {node.name && <span class="dot">{splitSectionName(node.name).code}</span>}
          <span class="dot">{readTime} min read</span>
        </div>
      </header>

      <div class="article__body prose">
        <slot />
      </div>

      {
        (prev || next) && (
          <nav class="article__nav" aria-label="Section navigation">
            {prev ? (
              <a class="article__nav-link" href={articlePath(prev)}>
                <span>Previous</span>
                <strong>{displayTitleOf(prev)}</strong>
              </a>
            ) : (
              <span />
            )}
            {next ? (
              <a class="article__nav-link article__nav-link--next" href={articlePath(next)}>
                <span>Next</span>
                <strong>{displayTitleOf(next)}</strong>
              </a>
            ) : (
              <span />
            )}
          </nav>
        )
      }

      <footer class="article__footer">
        <a class="btn btn--link" href={sectionPath(node.slug)}>
          ← Back to {splitSectionName(node.name).code}
        </a>
        {
          tags.length > 0 && (
            <div class="article__tags">
              {tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )
        }
      </footer>
    </div>
  </article>
</BaseLayout>
