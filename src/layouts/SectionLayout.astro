---
import { render } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import EssayRow from "../components/EssayRow.astro";
import NoteRow from "../components/NoteRow.astro";
import CourseRow from "../components/CourseRow.astro";
import { sectionPath, splitSectionName, type BlogNode } from "../lib/blog";

interface Props {
  node: BlogNode;
}

const { node } = Astro.props;
const Intro = node.readme ? (await render(node.readme)).Content : null;
const description = node.description || `${node.name} — notes and articles.`;
const hasChildren = node.children.length > 0;
const hasArticles = node.articles.length > 0;
const ordered = node.articles.some((entry) => typeof entry.data.order === "number");
const { code, title } = splitSectionName(node.name);
---

<BaseLayout title={node.name} description={description}>
  <div class="page-head">
    <div class="container">
      <nav class="article__breadcrumb" aria-label="Breadcrumb">
        <a href="/blog/">Blog</a>
        {
          node.ancestors.map((crumb) => (
            <>
              <span aria-hidden="true"> / </span>
              <a href={sectionPath(crumb.slug)}>{splitSectionName(crumb.name).code}</a>
            </>
          ))
        }
      </nav>
      <h1 class="page-head__title">{code}</h1>
      {title && <p class="page-head__lead">{title}</p>}
    </div>
  </div>

  <section class="section section--tight">
    <div class="container">
      {
        Intro && (
          <div class="section-intro prose">
            <Intro />
          </div>
        )
      }

      {
        hasChildren && (
          <div class="course-list">
            {node.children.map((child) => (
              <CourseRow node={child} description />
            ))}
          </div>
        )
      }

      {
        hasArticles &&
          (ordered ? (
            <div class="note-list">
              {node.articles.map((entry, index) => (
                <NoteRow entry={entry} index={index + 1} />
              ))}
            </div>
          ) : (
            <div class="essay-list">
              {node.articles.map((entry) => (
                <EssayRow entry={entry} />
              ))}
            </div>
          ))
      }

      {
        !hasChildren && !hasArticles && <p class="empty-state">Nothing here yet.</p>
      }
    </div>
  </section>
</BaseLayout>
